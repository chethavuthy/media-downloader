# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Tool Paths
YT_DLP_PATH=yt-dlp
INSTALOADER_PATH=instaloader
GALLERY_DL_PATH=gallery-dl
COOKIES_PATH=cookies.txt

# Rate Limiting
MAX_DOWNLOADS_PER_USER=5
RATE_LIMIT_WINDOW_MINUTES=10

# File Settings
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT_SECONDS=300
CONCURRENT_DOWNLOADS=1

# Cleanup
AUTO_CLEANUP_MINUTES=30

# Logging
LOG_LEVEL=info

# Inline mode (video sent in chat as "via @bot")
MEDIA_CHAT_ID=  # Chat ID where bot uploads to get file_id (channel/group). Bot must be member.
BOT_USERNAME=  # For TikTok caption: "mention @BOT_USERNAME to download any video"
