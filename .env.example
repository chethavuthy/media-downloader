# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Tool Paths
YT_DLP_PATH=yt-dlp
INSTALOADER_PATH=instaloader
GALLERY_DL_PATH=gallery-dl

# Rate Limiting
MAX_DOWNLOADS_PER_USER=5
RATE_LIMIT_WINDOW_MINUTES=10

# File Settings
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT_SECONDS=300
CONCURRENT_DOWNLOADS=3

# Cleanup
AUTO_CLEANUP_MINUTES=30

# Logging
LOG_LEVEL=info
