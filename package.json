{
  "name": "telegram-video-downloader-bot",
  "version": "1.0.0",
  "description": "Telegram bot for downloading videos from multiple platforms with Khmer and English support",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:check": "wrangler check",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepare": "husky"
  },
  "keywords": [
    "telegram",
    "bot",
    "video",
    "downloader",
    "yt-dlp",
    "tiktok",
    "youtube",
    "instagram"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/containers": "^0.2.2",
    "dotenv": "^16.4.5",
    "telegraf": "^4.16.3",
    "youtube-dl-exec": "^3.0.30"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "wrangler": "^4.80.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
