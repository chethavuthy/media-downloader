# Telegram Bot Configuration
# Replace with your actual production bot token
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USE_WEBHOOK=true
# Set this to your deployed Worker URL + path, e.g.
# https://clipsniper-bot.<your-subdomain>.workers.dev/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Tool Paths
# On most production servers (Linux/Docker), these will be in the system PATH.
# If you are using specific paths, update them here.
YT_DLP_PATH=/usr/local/bin/yt-dlp
INSTALOADER_PATH=/usr/local/bin/instaloader
GALLERY_DL_PATH=/usr/local/bin/gallery-dl
COOKIES_PATH=cookies.txt

# Rate Limiting
# Production settings: more conservative than dev/testing
MAX_DOWNLOADS_PER_USER=20
RATE_LIMIT_WINDOW_MINUTES=60

# File Settings (Telegram allows up to 50MB for bots via default API)
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT_SECONDS=300
CONCURRENT_DOWNLOADS=1

# Cleanup
AUTO_CLEANUP_MINUTES=60

# Logging
# Use 'info' or 'warn' for production to keep logs clean
LOG_LEVEL=info

# Inline mode (optional but recommended)
MEDIA_CHAT_ID=
BOT_USERNAME=
