# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_production_bot_token_here
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Tool Paths
YT_DLP_PATH=yt-dlp
INSTALOADER_PATH=instaloader
GALLERY_DL_PATH=gallery-dl
COOKIES_PATH=cookies.txt

# Rate Limiting
MAX_DOWNLOADS_PER_USER=100
RATE_LIMIT_WINDOW_MINUTES=100

# File Settings
MAX_FILE_SIZE_MB=100
DOWNLOAD_TIMEOUT_SECONDS=600
CONCURRENT_DOWNLOADS=10

# Cleanup
AUTO_CLEANUP_MINUTES=30

# Logging
LOG_LEVEL=info

# Inline mode (video sent in chat as "via @bot")
MEDIA_CHAT_ID=your_media_chat_id_here
# Chat ID where bot uploads to get file_id (channel/group). Bot must be member.
BOT_USERNAME=your_bot_username_here
# For TikTok caption: "mention @BOT_USERNAME to download any video"

# Ask Grok inline mode (OpenAI-compatible chat completions API)
GROK_API_KEY=
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini
GROK_API_TIMEOUT_MS=30000

# Ask AI inline mode (primary: Gemini, with Brave/Tavily/Grok fallback chain)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_TIMEOUT_MS=30000
BRAVE_API_KEY=your_brave_api_key_here
BRAVE_API_BASE_URL=https://api.search.brave.com/res/v1
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_BASE_URL=https://api.tavily.com
AI_MAX_SEARCH_RESULTS=6
